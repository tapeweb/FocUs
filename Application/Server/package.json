{
  "name": "focus_server",
  "module": "Source/Application/Main.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --watch Source/Application/Main.ts",
    "database:generate": "bun drizzle-kit generate",
    "database:migrate": "bun drizzle-kit migrate",
    "database:seed": "bun run Source/Database/Seeds/Roles.ts",
    "start": "bun run Source/Application/Main.ts",
    "start:docker": "bun run database:generate && bun run database:migrate && bun run database:seed && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.31",
    "pg": "^8.23.1"
  }
}
