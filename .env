### | Postgres | ###
POSTGRES_HOST=focus_postgres
POSTGRES_USER=focus_postgres_user
POSTGRES_PASSWORD=focus_postgres_password
POSTGRES_DB=focus_postgres_database

POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
### | Postgres | ###

### | Server | ###
SERVICE_SERVER_NAME=focus_server
SERVICE_SERVER_PORT=3000
SERVICE_SERVER_URL=http://localhost:${SERVICE_SERVER_PORT}
### | Server | ###

### | Docker | ###
DOCKER_MODE=development
DOCKER_NETWORK_NAME=focus_network

COMPOSE_FILE=./docker/compose-files/docker-compose.${DOCKER_MODE}.yml
### | Docker | ###