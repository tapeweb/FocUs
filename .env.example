# Copy to .env and adjust: cp .env.example .env
### | Postgres | ###
POSTGRES_HOST=focus_postgres
POSTGRES_USER=focus_postgres_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=focus_postgres_database

# Host port that maps to 5432 in the container — change it if 5432 is taken locally
POSTGRES_PORT=5432
### | Postgres | ###

### | Docker | ###
DOCKER_MODE=development
DOCKER_NETWORK_NAME=focus_network

# Picked up by `docker compose` automatically when present in .env
COMPOSE_FILE=./docker/compose-files/docker-compose.${DOCKER_MODE}.yml
### | Docker | ###
